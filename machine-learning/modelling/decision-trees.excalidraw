    {
      "id": "1y-vzZAs9he8E3GRgvQPh",
      "type": "text",
      "x": 441.1606275030117,
      "y": 1036.7169122827897,
      "width": 551.87939453125,
      "height": 81,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aG",
      "roundness": null,
      "seed": 1935578155,
      "version": 246,
      "versionNonce": 1680790667,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752698349645,
      "link": null,
      "locked": false,
      "text": "Interpretability is a major advantage\n- check which features appear near the root (most important)\n- examine the decision paths for edge cases",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Interpretability is a major advantage\n- check which features appear near the root (most important)\n- examine the decision paths for edge cases",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "o4cgExeAiH3p6loxeHnTE",
      "type": "text",
      "x": 441.1606275030117,
      "y": 1166.713838397141,
      "width": 710.3789672851562,
      "height": 108,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aI",
      "roundness": null,
      "seed": 1780954309,
      "version": 298,
      "versionNonce": 135924523,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752698349646,
      "link": null,
      "locked": false,
      "text": "Watch for overfitting signs\n- perfect or near-perfect training accuracy with much lower validation accuracy\n- use learning curves to visualize the gap between training and validation\n   performance as you vary tree complexity",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Watch for overfitting signs\n- perfect or near-perfect training accuracy with much lower validation accuracy\n- use learning curves to visualize the gap between training and validation\n   performance as you vary tree complexity",
      "autoResize": true,
      "lineHeight": 1.35
    },
