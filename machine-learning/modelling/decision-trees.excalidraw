      "link": null,
      "locked": false,
      "text": "Categorical encoding matters tremendously\n- use one-hot encoding for nominal categories\n\n- avoid high-cardinality features (ex. zip codes)\n\nMissing values are handled naturally",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Categorical encoding matters tremendously\n- use one-hot encoding for nominal categories\n\n- avoid high-cardinality features (ex. zip codes)\n\nMissing values are handled naturally",
      "autoResize": true,
      "lineHeight": 1.35
