    {
      "id": "zJ2uMbyEnb2taeMVQlmTY",
      "type": "text",
      "x": 442,
      "y": 535.0100255602154,
      "width": 571.1392822265625,
      "height": 108,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 773269701,
      "version": 189,
      "versionNonce": 1088451083,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752698160930,
      "link": null,
      "locked": false,
      "text": "Controlling tree depth is critical\n- max_depth (how deep the tree can grow)\n- min_samples_split (minimum samples needed to split a node)\n- min_samples_leaf (minimum samples in each leaf)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Controlling tree depth is critical\n- max_depth (how deep the tree can grow)\n- min_samples_split (minimum samples needed to split a node)\n- min_samples_leaf (minimum samples in each leaf)",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "Ijlr80CzjpakrYFiWq6mk",
      "type": "text",
      "x": 442,
      "y": 693.2103878700647,
      "width": 500.2393493652344,
      "height": 108,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 243666987,
      "version": 224,
      "versionNonce": 281189381,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752698091416,
      "link": null,
      "locked": false,
      "text": "The splitting criterion matters for your problem type\n- \"gini\" for balanced datasets\n- \"entropy\" for more interpretable splits in classification\n- for regression, \"mse\" works well for most cases",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The splitting criterion matters for your problem type\n- \"gini\" for balanced datasets\n- \"entropy\" for more interpretable splits in classification\n- for regression, \"mse\" works well for most cases",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "faJtrkxQ1Kl5_LcV890jN",
      "type": "text",
      "x": 442,
      "y": 851.4107501799141,
      "width": 416.03948974609375,
      "height": 81,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 1250476491,
      "version": 329,
      "versionNonce": 506314635,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752698125016,
      "link": null,
      "locked": false,
      "text": "Pruning is essential\n- early stopping (through hyperparams above)\n- post-pruning",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pruning is essential\n- early stopping (through hyperparams above)\n- post-pruning",
      "autoResize": true,
      "lineHeight": 1.35
    },
