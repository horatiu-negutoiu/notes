    {
      "id": "gt_HTP2Y0S92EQ-fMYoMT",
      "type": "text",
      "x": 849.4511591593425,
      "y": -454.6094494047619,
      "width": 553.71923828125,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 1044436749,
      "version": 931,
      "versionNonce": 1182682211,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "4ryARjifHw9BB8UuJs7nY",
          "type": "arrow"
        }
      ],
      "updated": 1752691083077,
      "link": null,
      "locked": false,
      "text": "Regularization is your friend\n- key hyperparameter is \"regularization strength\" C\n- smaller C => more regularization\n- use L1 regularization (Lasso) for automatic feature selection\n- use L2 regularization (Ridge) for overfitting prevention",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Regularization is your friend\n- key hyperparameter is \"regularization strength\" C\n- smaller C => more regularization\n- use L1 regularization (Lasso) for automatic feature selection\n- use L2 regularization (Ridge) for overfitting prevention",
      "autoResize": true,
      "lineHeight": 1.35
    },
