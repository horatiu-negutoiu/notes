      "updated": 1752634874203,
      "link": null,
      "locked": false,
      "text": "PROS:\n- less prone to overfitting\n- can handle high-dimensional data\n- no need for feature selection",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
