      "isDeleted": false,
      "boundElements": null,
      "updated": 1752634874203,
      "link": null,
      "locked": false,
      "text": "A simple algorithm that models a linear\nrelationship between inputs and a continuous\nnumerical output variable\n\nApplications:\n- stock price prediction\n- predicting housing prices\n- predicting customer lifetime value",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A simple algorithm that models a linear\nrelationship between inputs and a continuous\nnumerical output variable\n\nApplications:\n- stock price prediction\n- predicting housing prices\n- predicting customer lifetime value",
      "autoResize": true,
      "lineHeight": 1.35
    },
