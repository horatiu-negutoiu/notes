      "boundElements": null,
      "updated": 1752634874203,
      "link": null,
      "locked": false,
      "text": "Part of the regression family - it penalizes\nfeatures that have low predictive outcomes by\nshrinking their coefficients closer to zero. Can\nbe used for classification or regression\n\nApplications:\n- predictive maintenance for automobiles\n- sales revenue prediction",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Part of the regression family - it penalizes\nfeatures that have low predictive outcomes by\nshrinking their coefficients closer to zero. Can\nbe used for classification or regression\n\nApplications:\n- predictive maintenance for automobiles\n- sales revenue prediction",
      "autoResize": true,
      "lineHeight": 1.35
    },
