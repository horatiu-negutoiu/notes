      "boundElements": null,
      "updated": 1752634874203,
      "link": null,
      "locked": false,
      "text": "Decision Tree models make decision rules on\nthe features that produce predictions. It can be\nused for classification or regression\n\nApplications:\n- customer churn prediction\n- credit score modeling\n- disease prediction",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Decision Tree models make decision rules on\nthe features that produce predictions. It can be\nused for classification or regression\n\nApplications:\n- customer churn prediction\n- credit score modeling\n- disease prediction",
      "autoResize": true,
      "lineHeight": 1.35
    },
