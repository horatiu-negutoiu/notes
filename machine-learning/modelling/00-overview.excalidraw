      "versionNonce": 1174399143,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752634874203,
      "link": null,
      "locked": false,
      "text": "Part of the regression family - it penalizes\nfeatures that have low predictive outcomes by\nshrinking their coefficients closer to zero. Can\nbe used for classification or regression\n\nApplications:\n- predicting house prices\n- predicting clinical outcomes based on\n   health data",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Part of the regression family - it penalizes\nfeatures that have low predictive outcomes by\nshrinking their coefficients closer to zero. Can\nbe used for classification or regression\n\nApplications:\n- predicting house prices\n- predicting clinical outcomes based on\n   health data",
      "autoResize": true,
      "lineHeight": 1.35
    },
