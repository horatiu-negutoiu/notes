      "updated": 1752635093782,
      "link": null,
      "locked": false,
      "text": "The most widely used clustering approach - it\ndetermines K clusters based on euclidean\ndistances\n\nApplications:\n- customer segmentation\n- recommendation systems",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The most widely used clustering approach - it\ndetermines K clusters based on euclidean\ndistances\n\nApplications:\n- customer segmentation\n- recommendation systems",
      "autoResize": true,
      "lineHeight": 1.35
    },
