      "isDeleted": false,
      "boundElements": null,
      "updated": 1752634874203,
      "link": null,
      "locked": false,
      "text": "PROS:\n- better accuracy compared to other regression\n   models\n- it can handle multicollinearity\n- it can handle non-linear relationships",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PROS:\n- better accuracy compared to other regression\n   models\n- it can handle multicollinearity\n- it can handle non-linear relationships",
      "autoResize": true,
      "lineHeight": 1.35
    },
