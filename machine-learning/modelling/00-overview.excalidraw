      "isDeleted": false,
      "boundElements": null,
      "updated": 1752635231229,
      "link": null,
      "locked": false,
      "text": "A \"bottom-up\" approach where each data point\nis treated as its own cluster - and then the closes\ntwo custers are merged together iteratively\n\nApplications:\n- fraud detection\n- document clustering based on similarity",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A \"bottom-up\" approach where each data point\nis treated as its own cluster - and then the closes\ntwo custers are merged together iteratively\n\nApplications:\n- fraud detection\n- document clustering based on similarity",
      "autoResize": true,
      "lineHeight": 1.35
    },
