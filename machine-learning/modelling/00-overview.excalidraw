      "isDeleted": false,
      "boundElements": null,
      "updated": 1752634874203,
      "link": null,
      "locked": false,
      "text": "Employs boosting to make predictive models\nfrom an ensemble of weak predictive learners\n\nApplications:\n- predicting car emissing\n- predicting ride hailing fare amount",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Employs boosting to make predictive models\nfrom an ensemble of weak predictive learners\n\nApplications:\n- predicting car emissing\n- predicting ride hailing fare amount",
      "autoResize": true,
      "lineHeight": 1.35
    },
