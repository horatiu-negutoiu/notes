      "locked": false,
      "text": "PROS:\n- scales to large datasets\n- simple to implement and interpret\n- results in tight clusters",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PROS:\n- scales to large datasets\n- simple to implement and interpret\n- results in tight clusters",
