      "link": null,
      "locked": false,
      "text": "Edges are weighted connections\n- Positive weights mean the sending neuron encourages the receiving neuron to activate\n- Negative weights mean it inhibits activation\n- Large weights (positive or negative) create strong influence\n- Small weights create weak influence",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Edges are weighted connections\n- Positive weights mean the sending neuron encourages the receiving neuron to activate\n- Negative weights mean it inhibits activation\n- Large weights (positive or negative) create strong influence\n- Small weights create weak influence",
      "autoResize": true,
      "lineHeight": 1.35
    }
